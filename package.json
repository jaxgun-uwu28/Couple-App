{
  "name": "paw-and-us",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "map:validate": "node scripts/validate-house-map.mjs",
    "android:sync": "pnpm --filter web exec cap sync android"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
